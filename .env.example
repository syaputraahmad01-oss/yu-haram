# YUHA environment template. Copy to .env and fill in real values.
# Real credentials live ONLY in .env (git-ignored) or the deployment
# environment — never in this file, never in the repo, never in the browser.

# ── Database: Supabase PostgreSQL via Prisma ────────────────────────────────
# Region: AWS AP-NORTHEAST-2 (Seoul). Replace <PASSWORD> with the database
# password (percent-encode special characters). Do not change host/port/user
# without a verified technical reason.
#
# DATABASE_URL — Transaction Pooler, used by the running app (Prisma runtime).
# DIRECT_URL   — Session Pooler, used by prisma migrate / db push (admin ops).
#
# DATABASE_URL="postgresql://postgres.utyzmaqbkhhxrnymtzqc:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.utyzmaqbkhhxrnymtzqc:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── Optional: shared rate-limit store for multi-instance deployments ───────
# memory (default, per-process) | sqlite (single-host Bun) | postgres (shared
# via the Supabase database above; recommended once DATABASE_URL is set)
# YUHA_RATE_LIMIT_BACKEND=postgres

# ── Optional: Prisma query logging (debugging only; off by default) ────────
# YUHA_DB_LOG_QUERIES=1

NEXT_TELEMETRY_DISABLED=1

# YUHA stores provider credentials in the browser's Settings flow and sends
# them to the matching API route per request. Do not put real provider keys here.
# This file is a template only; it is not loaded as a source of provider keys.
